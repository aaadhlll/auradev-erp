{
  "name": "auradev-erp",
  "version": "0.1.1",
  "description": "Mercantile retail ERP desktop application",
  "author": "AuraDev",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "generate:import-sample": "node scripts/generate-import-sample.mjs",
    "generate:stock-sample": "node scripts/generate-stock-adjustment-sample.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "desktop:dev": "electron .",
    "desktop:backend": "node scripts/build-desktop-backend.mjs",
    "desktop:prepare": "npm run desktop:backend && npm run build && node scripts/prepare-electron.mjs",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win nsis"
  },
  "build": {
    "appId": "in.auradev.mercantile",
    "productName": "Mercantile",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next"
      },
      {
        "from": "desktop/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "desktop/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@swc/helpers": "0.5.15",
    "@tanstack/react-query": "^5.101.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
