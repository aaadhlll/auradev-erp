# Mercantile local desktop database settings.
# This file is copied to %APPDATA%\Mercantile\.env on first launch.
# Change these values before client delivery.
DB_URL=jdbc:postgresql://localhost:5433/auradev_erp
DB_USERNAME=auradev
DB_PASSWORD=auradev_local

# Use a different, long random value for each client installation.
JWT_SECRET=desktop-local-secret-change-before-client-delivery-32-chars
CORS_ALLOWED_ORIGINS=http://127.0.0.1:13000
APP_PUBLIC_BASE_URL=http://127.0.0.1:18080

# Optional on-premise recovery archives. Keep this folder on a protected local
# drive (or a mounted backup drive), never inside the app installation folder.
# PostgreSQL client tools must be installed so pg_dump is available on PATH.
APP_BACKUP_ENABLED=false
APP_BACKUP_DIR=C:\\MercantileBackups
APP_BACKUP_RETENTION_DAYS=30
# APP_BACKUP_PG_DUMP_PATH=C:\\Program Files\\PostgreSQL\\16\\bin\\pg_dump.exe
# If PostgreSQL runs in Docker instead, use the database container name.
# APP_BACKUP_MODE=DOCKER
# APP_BACKUP_DOCKER_CONTAINER=auradev-postgres
